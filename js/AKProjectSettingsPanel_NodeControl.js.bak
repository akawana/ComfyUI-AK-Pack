export function hideWidgetByName(node, widgetName) {
  if (!node || !node.widgets) return false;

  let changed = false;

  for (const w of node.widgets) {
    if (!w || w.name !== widgetName) continue;

    if (w.type !== "hidden") w.type = "hidden";
    w.hidden = true;

    w.computeSize = () => [0, 0];

    if (w.inputEl) {
      w.inputEl.style.display = "none";
      w.inputEl.style.height = "0px";
      w.inputEl.style.minHeight = "0px";
      w.inputEl.style.maxHeight = "0px";
      w.inputEl.style.padding = "0";
      w.inputEl.style.margin = "0";
    }

    changed = true;
  }

  if (changed && typeof node.setSize === "function" && Array.isArray(node.size)) {
    node.setSize([node.size[0], node.size[1]]);
  }

  return changed;
}

export function setOutputsHiddenByNames(node, outputNames, hidden) {
  if (!node || !node.outputs || !Array.isArray(outputNames)) return false;

  let changed = false;

  for (const o of node.outputs) {
    if (!o || !outputNames.includes(o.name)) continue;
    const next = hidden === true;
    if (o.hidden !== next) {
      o.hidden = next;
      changed = true;
    }
  }

  if (changed && typeof node.setDirtyCanvas === "function") {
    node.setDirtyCanvas(true, true);
  }

  return changed;
}

export function applyProjectSettingsOutVisibility(node, enableOptions) {
  hideWidgetByName(node, "ak_project_settings_json");

  const hideImage = enableOptions && enableOptions.open_image === false;
  setOutputsHiddenByNames(node, ["image", "image_filename", "image_path"], hideImage);
}
